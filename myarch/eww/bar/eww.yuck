;; put path to aesthetic bar config files here ;;
(defvar eww "$HOME/.local/bin/eww -c $HOME/.config/eww/bar")

;; Launcher Widgets ;;
(defwidget launcher []
	(box :orientation "v" 
		 :space-evenly "false" 
		 :spacing -15
  	(button :class "launcher_icon" 
		   	:onclick "eww --config ~/.config/eww/bar open launcher"  "")))

;; Niri Workspaces

(defwidget workspaces []
  (literal :content workspace))

(deflisten workspace 
  :initial "(box :class \"works\")"
  "scripts/workspace")

;; Battery Widgets ;;
(defwidget bat []
	(box	:orientation "v"	
			:space-evenly "false"
	(label	:class "bat"		
			:halign "end"		
			:text battery	
			:tooltip "Battery: ${battery-cappacity}%")))
(defpoll battery			:interval "1s"	"scripts/battery icon")
(defpoll battery-cappacity	:interval "30s"	"scripts/battery percent")

;; Wifi Widgets ;;
(defwidget wifi []
	(box		:orientation "v"  
				:tooltip wifi-name
	(button		:onclick "scripts/popup wifi" 
				:class "wifi-icon" wifi-icon)))
(defpoll wifi-icon :interval "1s" "scripts/wifi icon")
(defpoll wifi-name :interval "1s" "scripts/wifi name")

;; Brightness Widgets ;;

(defvar bright false)

(defwidget bright []
  (eventbox
:onhover "eww --config ~/.config/eww/bar update bright=true"
:onhoverlost "eww --config ~/.config/eww/bar update bright=false"
    (box
      :orientation "v"
      :space-evenly false
      :spacing 2

      (revealer
        :transition "slideup"
        :reveal bright
        :duration "550ms"

        (scale
          :class "bribar"
          :value current-brightness
          :tooltip "Brightness: ${current-brightness}%"
          :onchange "brightnessctl -d intel_backlight set {}%"
          :orientation "v"
          :flipped true))

      (label
        :class "brightness-icon"
        :text "󰃠"))))

(defpoll current-brightness
  :interval "1s"
  "brightnessctl -m -d intel_backlight | awk -F, '{print substr($4, 0, length($4)-1)}' | tr -d '%'")

;;; Volume Widgets ;;

(defvar volum false)

(defwidget volum []
  (eventbox
    :onhover "eww --config ~/.config/eww/bar update volum=true"
    :onhoverlost "eww --config ~/.config/eww/bar update volum=false"

    (box
      :orientation "v"
      :space-evenly false
      :spacing 2

      (revealer
        :transition "slideup"
        :reveal volum
        :duration "550ms"

        (scale
          :class "volbar"
          :value current-volume
          :orientation "v"
          :flipped true
          :tooltip "Volume: ${current-volume}%"
          :max 101
          :min 0
          :onchange "amixer -D pulse sset Master {}%"))

      (button
        :onclick "scripts/popup audio"
        :class "volume-icon"
        "󰕾"))))

(defpoll current-volume
  :interval "1s"
  "amixer -D pulse sget Master | grep 'Left:' | awk -F'[][]' '{ print $2 }' | tr -d '%'")

;Control Panel Widgets ;;	
(defwidget control []
	(box :orientation "v" 
		 :space-evenly false  
		 :class "control"
(bat)
(wifi)
(bright)
(volum)))

;; Clock Widgets ;;


(defwidget time []
  (eventbox
  :onhover "eww --config ~/.config/eww/bar open calendar"
  :onhoverlost "eww --config ~/.config/eww/bar close calendar"

  (box
    :orientation "v"
    :class "time"
    :valign "end"

    (button
      :class "time-day"
      day)

    (button 
      :class "time-hour"
      hour)

    (button
      :class "time-min"
      min))))


(defpoll day
  :interval "60s"
  "date '+%a'")

(defpoll hour
  :interval "1s"
  "date '+%H'")

(defpoll min
  :interval "1s"
  "date '+%M'")

;; Calendar Widgets ;;

(defwidget cal []
  (box
    :class "cal-box"
    :orientation "v"
    (box
      :class "cal-inner-box"
      (calendar
        :class "cal"
        :day calendar_day
        :month calendar_month
        :year calendar_year))))

(defpoll calendar_day
  :interval "10h"
  "date +%-d")

(defpoll calendar_month
  :interval "10h"
  "scripts/calendar")

(defpoll calendar_year
  :interval "10h"
  "date +%Y")


;; Powermenu Widgets ;;

(defvar power false)

(defwidget power []
  (eventbox
    :onhover "eww --config ~/.config/eww/bar update power=true"
    :onhoverlost "eww --config ~/.config/eww/bar update power=false"

    (box
      :orientation "v"
      :space-evenly false
      :vexpand false
      :class "powermenu"

      (revealer
        :transition "slideup"
        :reveal power
        :duration "550ms"

        (box
          :orientation "v"
          :space-evenly false

          (button
            :class "button-bspres"
            :tooltip "BSPWM Restart"
            :onclick "niri wm -r"
            "󱉋")

          (button
            :class "button-reb"
            :tooltip "Reboot"
            :onclick "eww update show-confirm=true"
            "󰜉")

          (button
            :class "button-quit"
            :tooltip "Logout"
            :onclick "killall niri"
            "󰍃")

          (button
            :class "button-lock"
            :tooltip "Lock Screen"
            :onclick "betterlockscreen -l"
            "")))

      (button
        :class "button-off"
        :tooltip "Shutdown"
        :onclick "shutdown now"
        "⏻"))))

(defvar show-confirm false)

(defwidget confirm-box []
  (box
    :orientation "h"
    :halign "center"
    :valign "center"
    :space-evenly true

    (label :text "Are you sure you want to reboot?" )

    (box
      :orientation "horizontal"
      :spacing 20

      (button
        :class "btn-confirm"
        :onclick "systemctl reboot"
	"󰜉"))))

;; Top Widgets ;;
(defwidget top []
	(box	:orientation "v" 
			:space-evenly "false" 
			:valign "start" 
(launcher)
(workspaces)))

;; Bottom Widgets ;;
(defwidget bottom []
	(box	:orientation "v" 
			:space-evenly false 
(time)
(power)))

;; End Widgets ;;
(defwidget end []
	(box :orientation "v" 
		 :space-evenly "false" 
		 :valign "end" 
		 :spacing 5
(control)
(bottom)))

;; Bar Widgets ;;

(defwidget bar []
  (box
    :orientation "h"

    (box
      :class "eww_bar"
      :orientation "v"
      :vexpand false
      :hexpand false

      (top)
      (end))

    (revealer
      :transition "slideright"
      :duration "300ms"
      :reveal show-cal

      (cal))))
(defwidget bar []
	(box :class "eww_bar" 
		 :orientation "v" 
		 :vexpand "false" 
		 :hexpand "false"
(top)
(end)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;							Window Section's							 ;;	
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Bar Windows ;;
(defwindow bar
	:geometry (geometry :x "0" 
	:y "0" 
	:height "100%" 
	:width "50px")
	:monitor 0
	:reserve (struts :distance "35px" 
	:side "left")
	:wm-ignore false
	:hexpand "false"
	:vexpand "false"
(bar))



(defwindow confirm
  :monitor 0
  :geometry (geometry
    :anchor "center"
    :width "400px"
    :height "200px")
  :stacking "overlay"
  :visible {show-confirm}

  :keybinds (
    ("Escape" "eww update show-confirm=false")
  )

  (confirm-box))

(defwindow launcher
  :monitor 0
  :geometry (geometry
    :x "50px"
    :y "50px"
    :width "300px"
    :height "200px")
  :stacking "fg"
  :exclusive false
  :focusable true
  (launcher))


