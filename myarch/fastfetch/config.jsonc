
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/moonlight.txt",

    "position": "left",

    // adjust this if your crescent is too big/small
    "width": 12,
    "height": 14
  },

  "display": {
    "separator": "  ",

    "color": {
      "keys": "#FF8C8C",     // peach accent for labels
      "title": "#7DF9FF"     // neon cyan accent
    },

    "key": {
      "width": 10
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
        {
        "type": "host",
        "key": "Host",
        "format": "{2}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",

    {
        "type": "cpu",
        "key": "CPU",
        "format": "{1} ({4})"
    },
    {
        "type": "gpu",
        "key": "GPU ",
        "index": 1,
        "format": "{2}"
    },
    "memory",
    {
        "type": "disk",
        "key": "Space ",
        "format": "{size-used} / {size-total} [{size-percentage}]",
        "folders": "/",
        "percent": {
           "type": ["num"]
        }
    }
  ]
}
