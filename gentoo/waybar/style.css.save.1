	0 0 1px @scarlet,
	0 0 2px @crimson;
}

/* === WINDOW === */

#window {
	font-family: "Magnolia Script", "Rubik";
	font-size: 18px;
	color: @rosewater;
	text-shadow:
	0 0 1px @flamingo,
	0 0 1px @peach,
	0 0 1px @red;
	padding: 0 15px;
	border: none;
}
#window:hover {
       	color: @flamingo;
       	text-shadow:
       	0 0 2px @white,
       	0 0 6px @peach;
}

#mpd {
    background: linear-gradient(
       	90deg,
       	alpha(@peach, 0.18),
       	alpha(@jade, 0.18)
    );
    font-family: "Iosevka", "Symbols Nerd Font", "Rubik";
    font-size: 20px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 999px;
    border-top: 1px solid @black;
    border-left: 1px solid @black;
    border-right: 1px solid @black;
    border-bottom: 1px solid @black;

    transition:
	border 0.75s ease,
        background 0.25s ease;
}
#mpd:hover {
    background: linear-gradient(
        90deg,
        alpha(@peach, 0.38),
        alpha(@jade, 0.38)
    );
    border: 5px @peach;
}

#mpd.paused {
    color: @rose;
    text-shadow:
	0 0 1px @iris,
	0 0 1px @rosewater;
}

/* Stopped */
#mpd.stopped {
    color: @jade;
    text-shadow: none;
}

/* Disconnected */
#mpd.disconnected {
    color: @rosewater;
    text-shadow: none;
}


#mpd.playing {
    animation: mpd-wave 10s ease-in-out infinite;
}

@keyframes mpd-wave {
    0% {
        color: @iris;
        text-shadow:
            0 0 1px @iris,
            0 0 2px @rosewater;
    }

    25% {
        color: @rosewater;
        text-shadow:
            0 0 2px @iris,
            0 0 2px @foam,
            0 0 1px @rosewater;
    }

    50% {
        color: @foam;
        text-shadow:
            0 0 2px @foam,
            0 0 2px @pine,
            0 0 2px @foam;
    }

    75% {
        color: @rosewater;
        text-shadow:
            0 0 2px @foam,
            0 0 2px @khaki,
            0 0 1px @rosewater;
    }

    100% {
        color: @iris;
        text-shadow:
            0 0 1px @iris,
            0 0 2px @rosewater;
    }
}
