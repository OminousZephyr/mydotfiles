/* === GLOBAL === */

/* {
	font-family: "Rubik", "Fira Code", "GeistMono Nerd Font";
	font-size: 18px;
}*/

tooltip {
	font-family: "Rubik", "Fira Code";
	font-size: 15px;
	color: @teal;
	background: @base;
	min-width: 40px;
	border: 2px solid @cosmic;
	border-radius: 12;
}


/* === NOTIFICATIONS === */

#custom-notifications {
	background-color: @no1;
	color: @re1;
	font-size: 20px;
}

#custom-notifications:hover {
	color: @re0;
	background-color: @re1;
}

#custom-notifications.dnd-none {
	color: @re1;
}

#custom-notifications.dnd-none:hover {
	color: @re1;
	background-color: @re2;
}

/* === UPDATES === */

#custom-updates {
	color: @wh0;
	font-size: 20px;
	margin: 0 20px;
}

#custom-updates:hover {
	background-color: @gr1;
}


window#waybar {
	background: @mantle;
	opacity: 1;
}

window#waybar.hidden {
	opacity: 0;
}

#custom-meow {
	font-size: 20px;
	padding-left: 2;
	padding-right: 5;
	padding-bottom: 1px;
	
	color: @mauve;
	font-weight: bold;
	text-shadow:
	0 0 1 @cosmic,
	1 0 1 @purple,
	0 1 1 @purple,
	0 0 2 @cosmic;
}

#custom-meow:hover {
	color: @teal;
}


/* === WORKSPACES === */

#workspaces {
	border: none;
	font-weight: 900;
}

#workspaces button {
  font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands", "Symbols Nerd Font", "Zarame Gothic", "Rubik";
  font-size: 18px;
  padding: 0px 3px;
  margin: 0px 1px;
  border-radius: 28px;
  background: transparent;

  min-width: 28px; /* important: base size */

  transition:
    color 220ms ease-in-out,
    text-shadow 220ms ease-in-out,
    padding 220ms ease-in-out,
    min-width 220ms ease-in-out;
}

#workspaces button label {
	font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands", "Symbols Nerd Font", "Zarame Gothic","Zarame Gothic Black", "Rubik";
	font-size: 20px;
	color: @peach;
	  text-shadow:
	0 0 1px @peach,
	0 0 3px @crust;
}

#workspaces button.active {
  color: @blue;
  padding: 0px 5px;
  min-width: 40px;
}

#workspaces button.active label {
	color: @teal;
	text-shadow:
	0 2 2px @cosmic,
	0 2 4px @turqouise,
	0 0 10px @sky,
	0 0 18px @blue;
}

#workspaces button:hover {
	background-color: @mantle;
}

#workspaces button:hover label {
	color: @peach;
}

#workspaces button.active:hover {
	background-color: @mantle;
}

#workspaces button.active label {
	color: @sapphire;
}

#workspaces button.urgent {
	background-color: @sapphire;
}

#workspaces button.urgent label {
	color: @sapphire;
}

