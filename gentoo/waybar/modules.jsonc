{	/* BRIGHTNESS 
	"custom/brightness": {
		"exec": "~/.config/waybar/scripts/bright-status.sh",
		"interval": 1,
		"return-type": "json",
		"format": "{text}",
		"markup": true,
		"tooltip": true,
		"on-scroll-up": "~/.config/waybar/scripts/bright.sh up",
		"on-scroll-down": "~/.config/waybar/scripts/bright.sh down"
	},*/

       	"backlight": {
               	// "interval":
               	"format": "{icon} {percent}%",
               	"format-icons": [
                       	"", "", "", "", "", "", "", "", ""
               	],
               	"min-length": 7,
               	"max-length": 7,
               	// "align":
               	// "justify":
               	// "rotate":
               	// "states":
               	// "on-click":
               	// "on-click-middle":
               	// "on-click-right":
               	// "on-update":
               	//"on-scroll-up": "~/.config/waybar/scripts/backlight up",
               	//"on-scroll-down": "~/.config/waybar/scripts/backlight down",
               	// "smooth-scrolling-threshold":
               	// "reverse-scrolling":
               	// "reverse-mouse-scrolling":
               	// "scroll-step":
               	// "min-brightness":
               	// "tooltip":
               	"tooltip-format": "Screen Brightness"
               	// "menu":
               	// "menu-file":
               	// "menu-actions":
               	// "expand":		}
	},
	/* BATTERY */
	"battery": {
		"format": "{capacity}% {icon}",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{time} {icon}",
		"format-icons": [
			"󰂎",
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		],
		"tooltip": false,
		"interval": 5,
		"states": {
			"warning": 30,
			"critical": 10
		}
	},
	/* BLUETHOOTH 
	"bluetooth": {
		"format": "",
		"format-disabled": "",
		"format-connected": " {num_connections}",
		"format-connected-battery": "{icon} {num_connections}",
		"format-icons": [
			"󰥇",
			"󰤾",
			"󰤿",
			"󰥀",
			"󰥁",
			"󰥂",
			"󰥃",
			"󰥄",
			"󰥅",
			"󰥆",
			"󰥈"
		],
		"tooltip-format": "{controller_alias}\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\t{icon} {device_battery_percentage}%",
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh blueman-manager blueman-manager"
	}, */
	/* CLOCKS */
"clock#time": {
    "format": "{:%H:%M:%OS %Z}",
    "interval": 1,
    "tooltip-format": "                      <span font_desc='20px' color='#f2cdcd'><b>{:%B %Y}</b></span><tt><span font_desc='18px' font-family='JetBrains Mono'>{calendar}</span></tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "left",
        "format": {
            "months":     "",
            "days":       "<span color='#f5f5dc'>{}</span>",
            "weeks":      "<span color='#ff8c8c'><b>{}  </b></span>",
            "weekdays":   "<span color='#40e0d0'>{}</span>",
            "today":      "<span color='#313244' background='#40e0d0'><b>{}</b></span>"
        }
    }
},
"custom/worldclocks": {
    "format": "{}",
    "interval": 30,
    "return-type": "json",
    "exec": "echo \"{\\\"text\\\":\\\"$(date +'%H:%M:%OS %Z')\\\",\\\"tooltip\\\":\\\"<span font_family='Rubik' font_desc='18px' color='#94e2d5'>$(TZ='America/New_York' date '+%H:%M')   New-York\\\\n$(TZ='Europe/London' date '+%H:%M')   London\\\\n$(TZ='Asia/Tokyo' date '+%H:%M')   Tokyo</span>\\\"}\""
},

"clock#date": {
    "format": "{:%a %d %b}",
    "tooltip-format": "                      <span font_desc='20px' color='#f2cdcd'><b>{:%B %Y}</b></span><tt><span font_desc='18px' font-family='JetBrains Mono'>{calendar}</span></tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "left",
        "format": {
            "months":     "",
            "days":	  "<span color='#f5f5dc'>{}</span>",
            "weeks":	  "<span color='#ff8c8c'><b>{}  </b></span>",
            "weekdays":   "<span color='#40e0d0'>{}</span>",
            "today":	  "<span color='#313244' background='#40e0d0'><b>{}</b></span>"
	}
	}
},
	/* CPU USAGE */
	"cpu": {
		"format": " {usage}%",
		"tooltip-format": "CPU",
		"interval": 2
	},
	"temperature#cpu": {
		"critical-threshold": 90,
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh scratchpad-btop 'kitty --class scratchpad-btop btop' scratchpad-large",
		"hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
		"format-critical": "{icon} {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"󰈸"
		],
		"tooltip-format": "CPU",
		"interval": 2
	},
	/* GPU USAGE */
	"custom/gpu-usage": {
		"exec": "cat /sys/class/hwmon/hwmon4/device/gpu_busy_percent",
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh scratchpad-nvtop 'kitty --class scratchpad-nvtop nvtop' scratchpad-large",
		"format": "GPU: {}%",
		"return-type": "",
		"interval": 2
	},
	"temperature#gpu": {
		"critical-threshold": 90,
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh scratchpad-nvtop 'kitty --class scratchpad-nvtop nvtop' scratchpad-large",
		"hwmon-path": "/sys/class/hwmon/hwmon2/temp2_input",
		"format-critical": "{icon} {temperatureC}°C",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"󰈸"
		],
		"tooltip-format": "GPU",
		"interval": 2
	},
	/* RAM USAGE */
	"memory": {
		"format": " {}%",
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh scratchpad-btop 'kitty --class scratchpad-btop btop' scratchpad-large",
		"tooltip-format": "RAM",
		"interval": 2
	},
	/* NETWORK */
	"network": {
		"format-wifi": "",
		"format-ethernet": "",
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh nm-connection-editor 'nm-connection-editor' scratchpad-large",
		"tooltip-format-wifi": "Network: <b>{essid}</b>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\n<span foreground='#eed49f'> {bandwidthDownBytes}</span> <span foreground='#b7bdf8'> {bandwidthUpBytes}</span>",
		"tooltip-format-ethernet": "Network: <b>{essid}</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>\n<span foreground='#eed49f'> {bandwidthDownBytes}</span> <span foreground='#b7bdf8'> {bandwidthUpBytes}</span>",
		"format-linked": "󰈀 {ifname} (No IP)",
		"format-disconnected": "󰖪 ",
		"tooltip": true,
		"interval": 2
	},
	/* AUDIO */
	"pulseaudio": {
		"format": "  {volume}%",
		"format-muted": "  MUTE",
		"interval": 1,
		"tooltip-format": "{desc}, {volume}%",
		/* "on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh org.pulseaudio.pavucontrol 'pavucontrol' scratchpad-large",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
	*/
	},
	/* LOGO */
	"custom/meow": {
		"format": " ♛ ",
		"tooltip": false,
		/* "on-click": "~/.config/rofi/scripts/powermenu/powermenu",
		"on-click-right": "rofi -show drun"
	*/
	},
	/* MUSIC */
	"custom/music": {
		"format": "{0}",
		"return-type": "json",
		"max-length": 40,
		"escape": true,
		"tooltip": true,
		"exec": "~/.config/waybar/scripts/mediaplayer.py",
		"on-click": "playerctl play-pause",
		"on-scroll-up": "playerctl next",
		"on-scroll-down": "playerctl previous",
		/* "on-click-right": "~/.config/waybar/scripts/switch-media-player.sh",*/
		"on-click-right": "~/.config/waybar/scripts/switch-to-spotify.sh"
	},
	/* NOTIFICATIONS */
	"custom/notifications": {
		"tooltip": false,
		"format": "{icon}",
		"format-icons": {
			"notification": "󰀧",
			"none": "󰀧",
			"dnd-notification": "󰳤",
			"dnd-none": "󰳤",
			"inhibited-notification": "<sup></sup>",
			"inhibited-none": "",
			"dnd-inhibited-notification": "<sup></sup>",
			"dnd-inhibited-none": ""
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "sleep 0.1 && swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
	/* UPDATES 
	"custom/updates": {
		"format": "{icon}",
		"return-type": "json",
		"tooltip": true,
		"format-icons": {
			"pending-updates": "󰋠",
			"updated": ""
		},
		"exec-if": "which waybar-updates",
		"exec": "waybar-updates",
		"on-click": "~/.config/hypr/scripts/toggle_scratchpad.sh scratchpad-large 'kitty --class scratchpad-large fish -c upall'",
		"hide-empty-text": true
	},*/
	/* LANG */
	"niri/language": {
		"format": "{}",
		"format-cs": "CZ",
		"format-en": "US",
		/* "on-click": "hyprctl switchxkblayout all next",
		"on-scroll-up": "hyprctl switchxkblayout all next",
		"on-scroll-down": "hyprctl switchxkblayout all next"
	*/
	},
	/* WINDOW */
	"niri/window": {
		"format": "{}",
		"max-length": 80,
		"rewrite": {
			"(.*) - Mozilla Firefox": "$1 󰈹",
			"(.*) - Visual Studio Code": "$1 󰨞",
			"(.*)Spotify": "Spotify 󰓇",
			"(.*) - Obsidian": "Obsidian ",
			"(.*)Steam": "Steam 󰓓"
		},
		"separate-outputs": false
	},
	/* WORKSPACES */
	"niri/workspaces": {
		"disable-scroll": true,
		"active-only": false,
		"all-outputs": false,
		"enable-bar-scroll": true,
		"format": "{icon}",
		"format-icons": {
        "ichi": "一",
        "ni": "二",
        "san": "三",
        "4": "四",
        "5": "五",
        "6": "六",
        "7": "七",
        "8": "八",
        "9": "九",
        "10": "十"
    }
		},
		/*"on-scroll-up": "hyprctl dispatch workspace r-1",
		"on-scroll-down": "hyprctl dispatch workspace r+1",
		"on-click": "activate",
		"sort-by-number": true
	*/
	},
	/* TRAY */
	"tray": {
		"icon-size": 16,
		"spacing": 10
	}
}
