[
	/* BAR 1
	Left:  Powermenu, workspaces
	Mid:   Date, Music, Time
	Right: Network, Keyboard Layout, Audio */

	{
		"include": "~/.config/waybar/modules.jsonc",
		"height": 35,
		"layer": "top",
		"exclusive": true,
		"passtrough": false,
		"gtk-layer-shell": true,
		"margin-top": 0,
		"margin-left": 0,
		"margin-bottom": 0,
		"margin-right": 0,
		"on-scroll-threshold": 1,
		"modules-left": [
			"custom/meow",
			"group/hardware-drawer"
		],
		"modules-center": [
			"niri/workspaces"
		],
		"modules-right": [
			"clock#date",
			"custom/worldclock",
			"network",
			"pulseaudio",
			"battery"
		],
		"group/hardware-drawer": {
		"orientation": "horizontal",
		"drawer": {
        "transition-duration": 500,
        "transition-left-to-right": false
	},
	
	"modules": [
        "backlight",    /* The main visible icon you hover over */
        "cpu",          /* Hidden until hovered */
        "memory",       /* Hidden until hovered */
        "temperature"   /* Hidden until hovered */
    ]
}
`]
