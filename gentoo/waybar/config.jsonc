	/* BAR 2
	Left:  Powermenu, workspaces
	Mid:   Date, Current Window, Time
	Right: RAM, GPU, CPU, Brightness, Notifications, Tray
	*/
	{
		"include": "~/.config/waybar/modules.jsonc",
		"height": 35,
		"layer": "top",
		/*"output": "YOUR-SECOND-MONITOR-NAME",
		"mode": "dock",*/
		"exclusive": true,
		"passtrough": false,
		"gtk-layer-shell": true,
		"margin-top": 0,
		"margin-left": 0,
		"margin-bottom": 0,
		"margin-right": 0,
		"on-scroll-threshold": 1,
		"modules-left": [
			"custom/meow",
			"niri/workspaces"
		],
		"modules-center": [
			"clock#date",
			"custom/worldclocks",
			/* "clock#time", */
			"niri/window",
			"network",
			"pulseaudio"
		],
		"modules-right": [
		/*	"bluetooth", */
			"memory",
			"cpu",
			"temperature#cpu",
			/* "temperature#gpu", */
			"backlight",
			"battery"
		]
	}	
]
