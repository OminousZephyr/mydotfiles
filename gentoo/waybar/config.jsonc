# ---------------------------------------
*/
[

	{
		"include": "~/.config/waybar/modules.jsonc",
		"height": 35,
		"layer": "top",
		"exclusive": true,
		"passtrough": false,
		"gtk-layer-shell": true,
		"margin-top": 0,
		"margin-left": 0,
		"margin-bottom": 0,
		"margin-right": 0,
		"on-scroll-threshold": 1,
		"modules-left": [
			"clock#date",
			"custom/worldclocks",
			"mpd"
		],
		"modules-center": [
			"niri/workspaces"
		],
		"modules-right": [
			"group/hardware-drawer",
			"network",
			"pulseaudio",
			"battery"
		],
		
		"group/hardware-drawer": {
		"orientation": "horizontal",
		"drawer": {
		"transition-duration": 500,
		"transition-left-to-right": true
		},
	
		"modules": [
		"backlight",
		"cpu",
		"memory",
		"temperature"
		]
		}
	}    
]
