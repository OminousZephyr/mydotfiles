
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/moonlight.txt",

    "position": "left",

    "width": 12
  },

  "display": {
    "separator": "  ",

    "color": {
      "keys": "#FF8C8C",
      "title": "#7DF9FF"
    },

    "key": {
      "width": 20
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory"
  ]
}
